# Postgres connection
PG_URL=postgres://postgres:postgres@localhost:5432/polymarket

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Polymarket endpoints (overridable for staging)
GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
LIVE_DATA_WS_URL=wss://ws-live-data.polymarket.com

# Ingest tuning
DISCOVERY_POLL_MS=60000
REWARDS_CACHE_MS=300000
WS_PING_MS=10000
WS_RECONNECT_MIN_MS=1000
WS_RECONNECT_MAX_MS=30000
PERIODIC_SNAPSHOT_MS=300000
BOOK_LEVEL=2
SUBSCRIPTION_SHARD_SIZE=50

# Underlying symbols to track (comma separated)
UNDERLYING_SYMBOLS=btcusdt,ethusdt,solusdt,xrpusdt
