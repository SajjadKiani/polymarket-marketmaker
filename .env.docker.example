# Compose-level env. Copy to .env on the VPS:
#   cp .env.docker.example .env
# All fields have sensible defaults in docker-compose.yml; only override if needed.

POSTGRES_USER=polymarket
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=polymarket

LOG_LEVEL=info
LOG_PRETTY=false

# Which crypto symbols the underlying ingester subscribes to.
UNDERLYING_SYMBOLS=btcusdt,ethusdt,solusdt,xrpusdt,dogeusdt,bnbusdt

# Health-cron cadence (seconds) and report window (hours).
HEALTH_INTERVAL_SEC=86400
HEALTH_WINDOW_HOURS=24
